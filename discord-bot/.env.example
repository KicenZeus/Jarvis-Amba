# ==============================================================================
# JARVIS / AMBA BOT ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi ".env" dan isi nilai token serta rahasia Anda.
# JANGAN PERNAH MENGUNGGAH FILE ".env" ASLI KE GITHUB / REPOSITORY PUBLIK!
# ==============================================================================

# 1. Kredensial Discord Bot (Wajib)
# Dapatkan token bot dari Discord Developer Portal -> Applications -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# 2. n8n Automation Gateway
# Gunakan "http://n8n:5678/webhook/jarvis-discord" jika berjalan di dalam jaringan Docker
# Gunakan "http://localhost:5678/webhook/jarvis-discord" jika bot dijalankan langsung di host OS
N8N_WEBHOOK_URL=http://n8n:5678/webhook/jarvis-discord
N8N_TIMEOUT_MS=60000

# 3. Kontrol Akses & Perizinan (Phase 7 RBAC)
# ID Discord pemilik utama yang otomatis memiliki hak akses OWNER (Level 4)
# Contoh: 713137141072396370
OWNER_DISCORD_ID=your_discord_user_id_here

# Allowlist ID Discord pengguna yang diizinkan (opsional, pisahkan koma)
# Jika dikosongkan, bot akan berinteraksi dengan semua pengguna secara terbuka
ALLOWED_USER_IDS=

# 4. Database PostgreSQL (Phase 0 - 8)
# Dikelola secara otomatis oleh docker-compose (default: jarvis)
DB_HOST=postgres
DB_PORT=5432
DB_USER=jarvis
DB_PASSWORD=your_secure_db_password
DB_NAME=jarvis

# 5. Internal Notification & Health Check Listener (Phase 3 & 8)
NOTIFY_PORT=5001

# 6. Speech-to-Text & External AI Key (Opsional)
# Digunakan untuk transkripsi audio tingkat lanjut / fallback Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
