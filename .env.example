# ==============================================================================
# JARVIS / AMBA V2 ALL-IN-ONE ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi ".env" atau ke folder "discord-bot/.env"
# JANGAN PERNAH MENGUNGGAH FILE ".env" ASLI KE GITHUB!
# ==============================================================================

# --- DISCORD BOT CONFIGURATION ---
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_DISCORD_ID=your_discord_user_id_here
ALLOWED_USER_IDS=

# --- AUTOMATION & N8N ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/jarvis-discord
N8N_TIMEOUT_MS=60000

# --- POSTGRESQL DATABASE ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=jarvis
DB_PASSWORD=jarvis_secure_pass_2026
DB_NAME=jarvis

# --- OPTIONAL AI / EXTERNAL ---
GEMINI_API_KEY=your_gemini_api_key_here
TZ=Asia/Jakarta
