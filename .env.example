# ==============================================================================
# JARVIS / AMBA V3 ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi ".env" atau ke folder "discord-bot/.env"
# JANGAN PERNAH MENGUNGGAH FILE ".env" ASLI KE GITHUB!
# ==============================================================================

# --- IDENTITAS & OWNER (Phase 0-A Security) ---
# Daftar ID Snowflake Discord / Nomor WA Owner (pisahkan dengan koma jika multi-owner)
OWNER_USER_IDS=713137141072396370
OWNER_DISCORD_ID=713137141072396370
ALLOWED_USER_IDS=

# --- DISCORD BOT CONFIGURATION ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- WHATSAPP CLOUD API & SECURITY (Phase 0-A) ---
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WA_ACCESS_TOKEN=your_permanent_access_token_here
WA_VERIFY_TOKEN=jarvis_amba_wa_secret_2026
WA_APP_SECRET=your_meta_app_secret_here
# Ubah ke true setelah Meta App Secret terpasang untuk menolak webhook palsu (401)
WA_SIGNATURE_ENFORCE=false

# --- INTERNAL API SECURITY (Phase 0-A Port 5001) ---
INTERNAL_API_KEY=jarvis_internal_secret_key_2026
INTERNAL_KEY_ENFORCE=false

# --- AI CORE & AUTOMATION ENGINE ---
# Default V3: Direct Gemini AI aktif sebagai otak utama (USE_N8N=false)
USE_N8N=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/jarvis-discord
N8N_TIMEOUT_MS=8000
GEMINI_API_KEY=your_gemini_api_key_here

# --- POSTGRESQL DATABASE ---
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=jarvis
DB_PASSWORD=jarvis_secure_pass_2026
DB_NAME=jarvis

# --- SYSTEM & LOCALIZATION ---
TZ=Asia/Jakarta
PORT=5001
