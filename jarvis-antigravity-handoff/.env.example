# Discord bot token — isi sendiri secara lokal, jangan commit nilai nyata
DISCORD_TOKEN=

# Production Webhook URL setelah workflow n8n disimpan dan diaktifkan
N8N_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-discord

# Allowlist IDs, pisahkan beberapa ID dengan koma. Biarkan kosong hanya jika agent mengatur default-deny secara eksplisit.
ALLOWED_USER_IDS=
ALLOWED_GUILD_IDS=

# Default timezone
TZ=Asia/Jakarta

# Isi bila provider AI sudah dipilih dan integrasinya benar-benar dibuat
GEMINI_API_KEY=
