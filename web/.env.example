# ==============================================================================
# JARVIS WEB DASHBOARD ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Gateway API (Railway URL saat production, atau localhost saat dev)
# Contoh Local: http://localhost:3000/api/v1
# Contoh Prod : https://jarvis-backend.up.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase Credentials (Untuk Realtime WebSocket & Supabase Auth)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

